    given-names: Sebastien
    email: sebastian.rousseau@gmail.com
version: "0.0.18"
date-released: "2026-08-29"
license: "Apache-2.0 OR MIT"
repository-code: "https://github.com/sebastienrousseau/camt-exceptions"
url: "https://camt-exceptions.com"
keywords:
  - ISO 20022
  - camt.056
  - camt.029
  - payment cancellation
  - exceptions and investigations
  - Model Context Protocol
  - MCP
  - AI agents
  - banking
